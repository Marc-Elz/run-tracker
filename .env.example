# Copy to .env.local (gitignored) and fill in. Free key: https://cloud.maptiler.com/account/keys/
# The key ends up inside the app bundle, so treat it as public: in the MapTiler dashboard restrict it
# to the app's origins. MapTiler wants bare domains, one per line: `localhost` (the app runs at
# https://localhost on the phone) and `marc-elz.github.io` (the web demo, #162, which uses this
# same key: the free plan allows only one).
VITE_MAPTILER_KEY=
